# Database
DATABASE_URL="postgresql://faheem:faheem_dev_password@localhost:5432/faheem_db?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"

# Auth & JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-faheem-2026"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-faheem-2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption key for SystemSetting secrets (32-byte hex or arbitrary string hashed to 32 bytes)
SETTINGS_ENCRYPTION_KEY="faheem-settings-aes256-gcm-master-key-change-in-prod"

# Payment Webhook HMAC secret (also configurable dynamically in SystemSetting)
PAYMENT_WEBHOOK_SECRET="faheem-webhook-hmac-secret-2026"

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_DEV_ECHO=true
